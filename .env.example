# cache-guardian — copy values into the host environment if needed.
# Direct-copy install is still a single file: extensions/cache-guardian.ts
# This file is documentation only; the extension does not load it.

# Extra diagnostic logs to stderr (off by default)
# PI_CACHE_GUARD_VERBOSE=0

# Session-end cache-guard warning (off by default)
# PI_CACHE_GUARD=0
# PI_CACHE_GUARD_THRESHOLD=90

# Opt-in lossless compact of a recognized <available_skills> listing (off by default)
# PI_CACHE_GUARD_SKILL_COMPACT=0

# Delete legacy prompt_cache_retention only (off by default)
# PI_CACHE_GUARD_STRIP_RETENTION=0

# Custom TUI footer (on by default; set 0 to disable)
# PI_CACHE_GUARD_FOOTER=1

# Read-only prefix-change snapshot at this extension's before_provider_request hook
# (on by default). Set 0/false/off/no to disable.
# This is not a cache-hit verdict, not the final HTTP body, and not server token prefix.
# Character counts are not tokens. Stable comparable fields do not freeze the prompt.
# Observation budgets are JSON-like limits, not a sandbox for arbitrary JavaScript.
# Missing/empty identity skips and clears the comparison chain (next valid = baseline).
# Extras require exactly one well-formed unique tagged block (supported tag-like ends only).
# Recognized shape is compared inside a scope; mixed exclusive own fields stay unknown.
# PI_CACHE_GUARDIAN_PREFIX_DIAGNOSTICS=1
